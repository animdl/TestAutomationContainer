#!/usr/bin/env python3

import json
import os
from datetime import datetime, timezone
from pathlib import Path
import subprocess
import sys

IMAGE = os.environ.get("BENCH_IMAGE", "bench:latest")
DEVICES = ("/dev/nvme0n1", "/dev/nvme1n1")

TESTS = [
    ("2a", "nvme smart-log /dev/nvme0n1 -o json"),
    ("2b", "nvme smart-log /dev/nvme1n1 -o json"),
    ("3a", "nvme device-self-test /dev/nvme0n1 -s 2 -w"),
    ("3b", "nvme device-self-test /dev/nvme1n1 -s 2 -w"),
    ("4a", "nvme self-test-log /dev/nvme0n1 -o json"),
    ("4b", "nvme self-test-log /dev/nvme1n1 -o json"),
    ("6", "memtester 20G 5"),
    ("7", "stressapptest -s 1800 -M 18000 -m 32 -W"),
    ("8", "stress-ng --cpu 0 --cpu-load 75 --timeout 30m"),
    ("9", 'sysbench --threads="$(nproc)" --time=90 cpu run'),
    ("11", "cuda_memtest --stress --num_iterations 1000 --num_passes 2 --verbose 2"),
    ("12", "gpu-burn -tc 1800"),
    ("13a", "nvbandwidth -t host_to_device_memcpy_ce -b 1024 -i 10 -j"),
    ("13b", "nvbandwidth -t device_to_host_memcpy_ce -b 1024 -i 10 -j"),
    ("13c", "nvbandwidth -t host_to_device_bidirectional_memcpy_ce -b 1024 -i 10 -j"),
    ("13d", "nvbandwidth -t host_to_device_bidirectional_memcpy_sm -b 1024 -i 10 -j"),
    ("13e", "nvbandwidth -t device_local_copy -b 1024 -i 10 -j"),
    ("14a", "stress-ng --cpu 0 --cpu-load 100 --timeout 30m"),
    ("14b", "gpu-burn -tc 1800"),
]

def timestamp():
    return datetime.now(timezone.utc).isoformat()

def docker_command(command):
    return [
        "docker",
        "run",
        "--rm",
        "--gpus",
        "all",
        "--privileged",
        f"--device={DEVICES[0]}",
        f"--device={DEVICES[1]}",
        IMAGE,
        "/bin/bash",
        "-lc",
        command,
    ]

def save(path, results):
    path.write_text(json.dumps(results, indent=2) + "\n", encoding="utf-8")

def main():
    run_name = datetime.now().strftime("%Y%m%d-%H%M%S")
    output_dir = Path("benchmark-results") / run_name
    if len(sys.argv) > 1:
        output_dir = Path(sys.argv[1])

    output_dir.mkdir(parents=True, exist_ok=True)
    output_file = output_dir / "results.json"
    results = {
        "image": IMAGE,
        "started_at": timestamp(),
        "tests": [],
    }

    for step, command in TESTS:
        print(f"\n[{step}] {command}", flush=True)
        completed = subprocess.run(
            docker_command(command),
            stdout=subprocess.PIPE,
            text=True,
            encoding="utf-8",
            errors="replace",
            check=False,
        )
        print(completed.stdout, end="", flush=True)

        results["tests"].append(
            {
                "step": step,
                "command": command,
                "exit_code": completed.returncode,
                "stdout": completed.stdout,
            }
        )
        save(output_file, results)

    results["finished_at"] = timestamp()
    save(output_file, results)
    print(f"\nResults: {output_file}")
    return int(any(test["exit_code"] != 0 for test in results["tests"]))

if __name__ == "__main__":
    raise SystemExit(main())
