; Safe, file-backed equivalent of pts/fio for two NVMe filesystems.
; Required bind mounts:
;   /fio-targets/nvme0 -> dedicated directory on nvme0 filesystem
;   /fio-targets/nvme1 -> dedicated directory on nvme1 filesystem
; Never replace filename values with /dev/nvme* device nodes.

[global]
ioengine=io_uring
direct=1
bs=128k
numjobs=4
iodepth=64
size=1g
time_based=1
runtime=60
ramp_time=5
startdelay=20
force_async=4
group_reporting=1
allow_mounted_write=0
exitall_on_error=1

[nvme0-randread]
filename=/fio-targets/nvme0/.fio-safe-test.bin
rw=randread

[nvme0-randwrite]
stonewall
filename=/fio-targets/nvme0/.fio-safe-test.bin
rw=randwrite

[nvme0-seqread]
stonewall
filename=/fio-targets/nvme0/.fio-safe-test.bin
rw=read

[nvme0-seqwrite]
stonewall
filename=/fio-targets/nvme0/.fio-safe-test.bin
rw=write

[nvme1-randread]
stonewall
filename=/fio-targets/nvme1/.fio-safe-test.bin
rw=randread

[nvme1-randwrite]
stonewall
filename=/fio-targets/nvme1/.fio-safe-test.bin
rw=randwrite

[nvme1-seqread]
stonewall
filename=/fio-targets/nvme1/.fio-safe-test.bin
rw=read

[nvme1-seqwrite]
stonewall
filename=/fio-targets/nvme1/.fio-safe-test.bin
rw=write
