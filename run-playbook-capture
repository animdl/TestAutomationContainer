#!/usr/bin/env python3
"""Capture only the newly added workloads using the full runner's machinery."""

from pathlib import Path
import runpy


CAPTURE_STEPS = ("11a", "11b", "13d", "13f")


def main():
    script = Path(__file__).resolve()
    loaded = runpy.run_path(str(script.with_name("run-playbook")))
    runner_main = loaded["main"]
    runner = runner_main.__globals__
    tests = [test for test in runner["TESTS"] if test[0] in CAPTURE_STEPS]
    if tuple(test[0] for test in tests) != CAPTURE_STEPS:
        raise RuntimeError("capture steps are missing or reordered in run-playbook")

    runner["PLAYBOOK"] = tests
    runner["TESTS"] = tests
    source_manifest = runner["source_manifest"]
    runner["source_manifest"] = lambda paths: source_manifest([*paths, script])
    return runner_main()


if __name__ == "__main__":
    raise SystemExit(main())
